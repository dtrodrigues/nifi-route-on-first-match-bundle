<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent version is the NiFi release built against; keep it equal to nifi.version below -->
    <parent>
        <groupId>org.apache.nifi</groupId>
        <artifactId>nifi-nar-bundles</artifactId>
        <version>1.28.1</version>
    </parent>

    <groupId>io.github.dtrodrigues</groupId>
    <artifactId>nifi-route-on-first-match-bundle</artifactId>
    <version>1.0.0-nifi1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>RouteOnFirstMatch for Apache NiFi</name>
    <description>A NiFi processor that routes each FlowFile to the first matching condition, with a drag-and-drop Advanced UI for ordering conditions</description>

    <url>https://github.com/dtrodrigues/nifi-route-on-first-match-bundle</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>dtrodrigues</id>
            <name>Dustin Rodrigues</name>
            <url>https://github.com/dtrodrigues</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/dtrodrigues/nifi-route-on-first-match-bundle</url>
        <connection>scm:git:https://github.com/dtrodrigues/nifi-route-on-first-match-bundle.git</connection>
        <developerConnection>scm:git:git@github.com:dtrodrigues/nifi-route-on-first-match-bundle.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <nifi.version>1.28.1</nifi.version>
        <!-- NiFi 1.x runs on Java 8, so the NAR must too; the tests do not ship, so they may use newer Java -->
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.testRelease>17</maven.compiler.testRelease>
        <!-- Fixed timestamp for reproducible builds; the NiFi parent otherwise supplies its own release date -->
        <project.build.outputTimestamp>2026-10-09T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <modules>
        <module>nifi-route-on-first-match-processors</module>
        <module>nifi-route-on-first-match-ui</module>
        <module>nifi-route-on-first-match-nar</module>
    </modules>

    <build>
        <plugins>
            <!-- The NiFi 1.x parent also compiles the tests with the Groovy compiler, which this project does not need -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>groovy-tests</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- The NiFi parent allows SNAPSHOT dependencies only on NiFi itself; allow this project's own modules too -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <configuration>
                            <rules>
                                <requireReleaseDeps>
                                    <excludes combine.children="append">
                                        <exclude>${project.groupId}:*</exclude>
                                    </excludes>
                                </requireReleaseDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
